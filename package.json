{
  "name": "harness-visualizer",
  "version": "0.1.0",
  "private": true,
  "description": "Static analyzer, typed IR and interactive visualizer for LLM agent harnesses",
  "type": "module",
  "bin": {
    "harness-viz": "./bin/harness-viz.mjs"
  },
  "scripts": {
    "analyze": "tsx src/cli.ts analyze",
    "cli": "tsx src/cli.ts",
    "build:data": "tsx scripts/build-site-data.ts",
    "dev": "npm run build:data && vite",
    "build": "npm run build:data && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "eval": "tsx scripts/evaluate.ts",
    "e2e": "node scripts/e2e.mjs",
    "gen:schema": "tsx scripts/gen-schema.ts",
    "gen:traces": "tsx scripts/gen-traces.ts",
    "gen:examples": "tsx src/cli.ts analyze fixtures/harnesses/simple-tool-loop --out examples/ir/simple-tool-loop.ir.json && tsx src/cli.ts analyze fixtures/harnesses/coding-agent --out examples/ir/coding-agent.ir.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "typescript": "^5.9.3",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "elkjs": "^0.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
